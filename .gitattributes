# Our regular development environment is dual-OS - the same working directory is accessed
# from both Windows and Linux. To avoid line ending issues, we're making all text files
# use Linux line endings.
* text eol=lf

# Store binary files directly in Git without line-ending conversion.
*.png -text
*.jpg -text
*.ico -text
*.dll -text
*.exe -text
*.zip -text
*.lib -text
*.so -text
*.doc -text
*.docx -text
*.xls -text
*.xlsx -text
*.ppt -text
*.pptx -text
*.pdf -text