    "refresh": "",
    "schemaVersion": 39,
    "tags": ["ctf", "user"],
    "templating": {
        "list": [
            {
                "name": "ctf",
                "label": "CTF",
                "type": "query",
                "datasource": { "type": "postgres", "uid": "postgres" },
                "query": "SELECT DISTINCT ctf_name FROM instance_actions UNION SELECT DISTINCT ctf_name FROM flag_submissions ORDER BY 1;",
                "refresh": 2,
                "includeAll": false,
                "multi": false,
                "sort": 1
            },
            {
                "name": "user",
                "label": "User",
                "type": "query",
                "datasource": { "type": "postgres", "uid": "postgres" },
                "query": "SELECT DISTINCT COALESCE(u.name, u.email, u.sub) AS display_name FROM users u ORDER BY 1;",
                "refresh": 2,
                "includeAll": false,
                "multi": false,
                "sort": 1
            }
        ]
    },
