                    "rawSql": "SELECT date_trunc('hour', fs.created_at) AS time, fs.challenge_name AS metric, COUNT(*) AS value FROM flag_submissions fs JOIN users u ON u.id = fs.user_id WHERE COALESCE(u.name, u.email, u.sub) = '$user' AND fs.ctf_name = '$ctf' AND fs.accepted = true AND fs.created_at BETWEEN $__timeFrom() AND $__timeTo() GROUP BY 1, 2 ORDER BY 1;",
                    "refId": "A",
                    "format": "time_series"
