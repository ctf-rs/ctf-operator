            "title": "Flag Submissions",
            "type": "row"
        },
        {
            "datasource": { "type": "postgres", "uid": "postgres" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "line",
                        "lineWidth": 2,
                        "fillOpacity": 20,
                        "gradientMode": "scheme",
                        "pointSize": 5,
                        "showPoints": "auto"
                    }
                },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "correct" },
                        "properties": [
                            { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
                        ]
                    },
                    {
                        "matcher": { "id": "byName", "options": "incorrect" },
                        "properties": [
                            { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
                        ]
                    }
                ]
            },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
            "id": 10,
            "options": {
                "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] },
                "tooltip": { "mode": "multi" }
            },
            "title": "Submissions Over Time",
            "type": "timeseries",
            "targets": [
                {
                    "rawSql": "SELECT date_trunc('hour', fs.created_at) AS time, CASE WHEN fs.cheated THEN 'cheated' WHEN fs.accepted THEN 'correct' ELSE 'incorrect' END AS metric, COUNT(*) AS value FROM flag_submissions fs JOIN users u ON u.id = fs.user_id WHERE COALESCE(u.name, u.email, u.sub) = '$user' AND fs.ctf_name = '$ctf' AND fs.created_at BETWEEN $__timeFrom() AND $__timeTo() GROUP BY 1, 2 ORDER BY 1;",
                    "refId": "A",
                    "format": "time_series"
                }
            ]
        },
        {
            "datasource": { "type": "postgres", "uid": "postgres" },
            "fieldConfig": {
                "defaults": {
                    "custom": {
                        "drawStyle": "bars",
                        "lineWidth": 1,
                        "fillOpacity": 80,
                        "stacking": { "mode": "normal" }
